            "AutoEssenceCapacityOnWeaponTab"
        ]
    },
    "AutoEssenceCapacityCountOCR": {
        "desc": "识别武器基质当前数量。只取左上角当前/2000里的当前值",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    70,
                    40,
                    150,
                    36
                ],
                // 武器基质 2004/2000
                "expected": [
                    "\\d+",
                    "// @i18n-skip"
                ],
                "only_rec": true
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
    "AutoEssenceCapacityOverflow": {
        "desc": "武器基质数量达到或超过 2000",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ExpressionRecognition",
                "custom_recognition_param": {
                    "expression": "1999 < {AutoEssenceCapacityCountOCR}",
                    "focus_matched_resolved_expression": true
                }
            }
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "AutoEssenceCapacityClickRecycle"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "武器基质已满，分解 200 个后再领取"
        }
    },
    "AutoEssenceCapacityEnough": {
        "desc": "武器基质数量低于 2000",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ExpressionRecognition",
                "custom_recognition_param": {
                    "expression": "{AutoEssenceCapacityCountOCR} < 2000"
