                "box_index": 1
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "[JumpBack]AutoEssenceCapacityEnter",
            "AutoEssenceClickObtainButton"
        ],
        "focus": {
            "Node.Action.Starting": "领取前确认武器基质库存"
        }
    },
