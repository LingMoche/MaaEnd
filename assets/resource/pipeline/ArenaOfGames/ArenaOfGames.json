{
    "ArenaOfGamesMain": {
        "desc": "百趣演武同花顺任务入口，需先打开抽牌界面",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "ArenaOfGamesInDrawMenu"
                ]
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "DoNothing"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "ArenaOfGamesDispatch"
        ]
    },
    "ArenaOfGamesDispatch": {
        "desc": "根据已确认的手牌选择下一步",
        "pre_delay": 0,
        "action": {
            "type": "DoNothing"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "ArenaOfGamesComplete",
            "ArenaOfGamesRejected",
            "ArenaOfGamesDraw0",
            "ArenaOfGamesDraw1",
            "ArenaOfGamesDraw2",
            "ArenaOfGamesDraw3",
            "ArenaOfGamesDraw4"
        ]
    },
    "ArenaOfGamesComplete": {
        "desc": "任意花色的1至5点已齐全，保留当前手牌",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ArenaOfGames.CheckStraightFlush",
                "custom_recognition_param": {
                    "condition": "complete"
                }
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "DoNothing"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": []
    },
    "ArenaOfGamesRejected": {
        "desc": "当前手牌已无法组成同花顺",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ArenaOfGames.CheckStraightFlush",
                "custom_recognition_param": {
