{
    "ArenaOfGamesMain": {
        "desc": "百趣演武抽牌任务入口，需先打开抽牌界面",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "ArenaOfGamesInDrawMenu"
                ]
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "DoNothing"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "ArenaOfGamesDecide"
        ]
    },
    "ArenaOfGamesDecide": {
        "desc": "单次识别手牌，按勾选目标牌型三态路由：凑成即结束（早停）、无法凑出转放弃、否则继续抽牌；next 由 Decide 动态覆盖",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ArenaOfGames.CheckHand",
                "custom_recognition_param": {
                    "condition": "recognized"
                }
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ArenaOfGames.Decide"
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [],
        "attach": {
            "hand_of_today": false,
            "flush": false,
            "full_house": false,
            "four_of_a_kind": false,
            "straight_flush": false
        }
    },
    "ArenaOfGamesDrawCard": {
        "desc": "点击抽牌按钮并循环重点，直到第 count+1 槽背面消失（wait_node 由 Decide 按手牌数覆盖）",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "ArenaOfGamesDrawCardButton"
                ]
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "RepeatUntilNotFoundAction",
                "custom_action_param": {
                    "action": "Click",
                    "interval_ms": 500,
                    "repeat_count": 10,
                    "wait_node": "ArenaOfGamesBackSlot1"
                }
            }
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "ArenaOfGamesDrawCardSuccess"
        ]
    },
    "ArenaOfGamesDrawCardSuccess": {
        "desc": "等待新抽的铭牌完整显示（recognized count 由 Decide 覆盖为手牌数+1）",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ArenaOfGames.CheckHand",
                "custom_recognition_param": {
                    "condition": "recognized",
                    "count": 1
                }
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "DoNothing"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "ArenaOfGamesDecide"
        ]
    },
    "ArenaOfGamesStop": {
        "desc": "当前手牌已凑成任一勾选的目标牌型，保留手牌并结束（早停）",
        "recognition": {
            "type": "DirectHit"
        },
        "pre_delay": 0,
        "action": {
            "type": "DoNothing"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": []
    },
    "ArenaOfGamesAbandon": {
        "desc": "重新识别放弃挑战按钮并点击",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "ArenaOfGamesInDrawMenu",
                    "ArenaOfGamesAbandonButton"
                ],
                "box_index": 1
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Click"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "ArenaOfGamesAbandonConfirm"
        ]
    },
    "ArenaOfGamesAbandonConfirm": {
        "desc": "确认百趣演武的放弃挑战弹窗",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "GrayCancelButton",
                    "YellowConfirmButtonType1"
                ],
                "box_index": 1
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Click"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "ArenaOfGamesWaitEmpty"
        ]
    },
    "ArenaOfGamesWaitEmpty": {
        "desc": "等待确认放弃后重置为空手",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ArenaOfGames.CheckHand",
                "custom_recognition_param": {
                    "condition": "recognized",
                    "count": 0
                }
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "DoNothing"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "ArenaOfGamesDecide"
        ]
    }
}
