index 0000000..9ccb475
--- /dev/null
+++ b/src/utils/githubUpdate.ts
@@ -0,0 +1,103 @@
+import * as semver from 'semver';
+
+export interface GitHubAsset {
+  name: string;
+  size: number;
+  browser_download_url: string;
+}
+
+export interface GitHubRelease {
+  tag_name: string;
+  name: string | null;
+  body: string | null;
+  prerelease: boolean;
+  draft?: boolean;
+  assets: GitHubAsset[];
+}
+
+export function parseGitHubUrl(value: string): { owner: string; repo: string } | null {
+  try {
+    const url = new URL(value);
+    if (
+      url.protocol !== 'https:' ||
+      url.hostname !== 'github.com' ||
+      url.port ||
+      url.username ||
+      url.password ||
+      url.search ||
+      url.hash
+    ) {
+      return null;
+    }
+    const match = url.pathname.match(/^\/([A-Za-z0-9-]+)\/([A-Za-z0-9_.-]+)\/?$/);
+    if (!match) return null;
+    const repo = match[2].replace(/\.git$/i, '');
+    if (!repo || repo === '.' || repo === '..') return null;
+    return { owner: match[1], repo };
+  } catch {
+    return null;
+  }
+}
+
+export function selectGitHubRelease(
+  releases: GitHubRelease[],
+  channel: 'stable' | 'beta',
+): GitHubRelease | null {
+  const candidates = releases.filter((release) => {
+    const version = semver.parse(release.tag_name.replace(/^v/i, ''));
+    if (release.draft || !version || semver.lt(version, '1.0.0')) return false;
+    if (channel === 'stable') return !release.prerelease && version.prerelease.length === 0;
+    return (
+      version.prerelease.length === 0 ||
+      version.prerelease.some((part) => part === 'beta' || part === 'rc')
+    );
+  });
+  candidates.sort((a, b) =>
+    semver.rcompare(a.tag_name.replace(/^v/i, ''), b.tag_name.replace(/^v/i, '')),
+  );
+  return candidates[0] || null;
+}
+
+/** Match the complete package name; debug symbols and another platform cannot win by size. */
+export function matchGitHubReleaseAsset(
+  release: GitHubRelease,
+  githubUrl: string,
+  projectName: string,
+  os: string,
+  arch: string,
+): GitHubAsset | null {
+  const repository = parseGitHubUrl(githubUrl);
+  if (!repository) return null;
+  const platforms: Record<string, string> = { windows: 'win', darwin: 'macos', linux: 'linux' };
+  const architectures: Record<string, string> = { amd64: 'x86_64', arm64: 'aarch64' };
+  const platform = platforms[os];
+  const architecture = architectures[arch];
+  if (!platform || !architecture) return null;
+  const extensions =
+    platform === 'win' ? ['.zip'] : platform === 'macos' ? ['.tar.gz', '.dmg'] : ['.tar.gz'];
+  const prefix = `${projectName}-${platform}-${architecture}-${release.tag_name}`;
+  for (const extension of extensions) {
+    const filename = prefix + extension;
+    const asset = release.assets.find((item) => {
+      if (item.name !== filename) return false;
+      try {
+        const url = new URL(item.browser_download_url);
+        const expected = `/${repository.owner}/${repository.repo}/releases/download/${encodeURIComponent(release.tag_name)}/${encodeURIComponent(filename)}`;
+        return (
+          url.protocol === 'https:' &&
+          url.hostname === 'github.com' &&
+          !url.port &&
+          !url.username &&
+          !url.password &&
+          !url.search &&
+          !url.hash &&
+          url.pathname === expected
+        );
+      } catch {
+        return false;
+      }
+    });
+    if (asset) return asset;
+  }
+  return null;
+}
diff --git a/tests/githubUpdate.test.ts b/tests/githubUpdate.test.ts
new file mode 100644
index 0000000..6ed52eb
--- /dev/null
+++ b/tests/githubUpdate.test.ts
@@ -0,0 +1,127 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  parseGitHubUrl,
+  selectGitHubRelease,
+  matchGitHubReleaseAsset,
+  type GitHubRelease,
+} from '../src/utils/githubUpdate.ts';
+
+const repository = 'https://github.com/LingMoche/MaaEnd';
+const project = 'MaaEnd-LingMoche';
+function release(tag: string, prerelease = false): GitHubRelease {
+  const filename = `${project}-win-x86_64-${tag}.zip`;
+  return {
+    tag_name: tag,
+    name: tag,
+    body: '',
+    prerelease,
+    draft: false,
+    assets: [
+      {
+        name: filename,
+        size: 100,
+        browser_download_url: `${repository}/releases/download/${tag}/${filename}`,
+      },
+    ],
+  };
+}
+
+test('GitHub URLs require the exact HTTPS repository host and two safe path segments', () => {
+  assert.deepEqual(parseGitHubUrl(repository), { owner: 'LingMoche', repo: 'MaaEnd' });
+  assert.deepEqual(parseGitHubUrl(repository + '.git'), { owner: 'LingMoche', repo: 'MaaEnd' });
+  for (const url of [
+    'https://github.com.evil.example/LingMoche/MaaEnd',
+    'https://evil.example/github.com/LingMoche/MaaEnd',
+    'https://user:pass@github.com/LingMoche/MaaEnd',
+    'http://github.com/LingMoche/MaaEnd',
+    repository + '/releases',
+    repository + '?redirect=other',
+    repository + '#other',
+    'https://github.com/LingMoche/%2e%2e',
+  ])
+    assert.equal(parseGitHubUrl(url), null, url);
+});
+
+test('stable selects the highest final version and ignores prereleases and drafts', () => {
+  const draft = { ...release('v99.0.0'), draft: true };
+  const candidates = [
+    release('v2.9.0'),
+    release('v2.34.0-beta.1', true),
+    draft,
+    release('v2.33.0'),
+  ];
+  assert.equal(selectGitHubRelease(candidates, 'stable')?.tag_name, 'v2.33.0');
+});
+
+test('a release without a title or body still offers its complete package', () => {
+  const candidate = { ...release('v2.33.0'), name: null, body: null };
+  assert.equal(selectGitHubRelease([candidate], 'stable')?.tag_name, 'v2.33.0');
+  assert.equal(
+    matchGitHubReleaseAsset(candidate, repository, project, 'windows', 'amd64')?.name,
+    `${project}-win-x86_64-v2.33.0.zip`,
+  );
+});
+
+test('beta uses semantic order including fork sequence numbers, regardless of API order', () => {
+  const candidates = [
+    release('v2.33.0-beta.2.lingmoche.2', true),
+    release('v2.33.0-beta.2.lingmoche.10', true),
+    release('v2.32.0'),
+  ];
+  assert.equal(selectGitHubRelease(candidates, 'beta')?.tag_name, 'v2.33.0-beta.2.lingmoche.10');
+  candidates.push(release('v2.33.0'));
+  assert.equal(selectGitHubRelease(candidates, 'beta')?.tag_name, 'v2.33.0');
+});
+
+test('no releases, unsupported channels, and non-updateable tags yield no published release', () => {
+  assert.equal(selectGitHubRelease([], 'beta'), null);
+  assert.equal(selectGitHubRelease([release('v2.33.0-beta.2', true)], 'stable'), null);
+  assert.equal(
+    selectGitHubRelease(
+      [
+        release('v0.1.0'),
+        release('DEBUG_VERSION'),
+        release('v2.33.0-ci.123', true),
+        release('v2.33.0-alpha.1', true),
+      ],
+      'beta',
+    ),
+    null,
+  );
+});
+
+test('Windows selects the complete matching fork archive, not symbols or another architecture', () => {
+  const candidate = release('v2.33.0-beta.2.lingmoche.1', true);
+  candidate.assets.unshift(
+    { ...candidate.assets[0], name: 'MaaEnd-pdb-win-x86_64.zip', size: 99999 },
+    {
+      ...candidate.assets[0],
+      name: candidate.assets[0].name.replace('x86_64', 'aarch64'),
+      size: 99999,
+    },
+    {
+      ...candidate.assets[0],
+      name: candidate.assets[0].name.replace(project, 'MaaEnd'),
+      size: 99999,
+    },
+  );
+  assert.equal(
+    matchGitHubReleaseAsset(candidate, repository, project, 'windows', 'amd64')?.name,
+    `${project}-win-x86_64-v2.33.0-beta.2.lingmoche.1.zip`,
+  );
+  assert.equal(matchGitHubReleaseAsset(candidate, repository, project, 'windows', 'arm64'), null);
+  assert.equal(matchGitHubReleaseAsset(candidate, repository, project, 'unknown', 'amd64'), null);
+});
+
+test('asset URL must belong to the selected fork, release and filename', () => {
+  for (const url of [
+    'https://github.com/MaaEnd/MaaEnd/releases/download/v2.33.0/bad.zip',
+    'https://evil.example/package.zip',
+    `${repository}/releases/download/v2.32.0/${project}-win-x86_64-v2.33.0.zip`,
+  ]) {
+    const candidate = release('v2.33.0');
+    candidate.assets[0].browser_download_url = url;
+    assert.equal(matchGitHubReleaseAsset(candidate, repository, project, 'windows', 'amd64'), null);
+  }
+});
