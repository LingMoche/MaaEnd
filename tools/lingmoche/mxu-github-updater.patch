+fn valid_github_repository(owner: &str, repo: &str) -> bool {
+    !owner.is_empty()
+        && owner.len() <= 39
+        && owner.bytes().all(|c| c.is_ascii_alphanumeric() || c == b'-')
+        && !repo.is_empty()
+        && repo.len() <= 100
+        && repo != "."
+        && repo != ".."
+        && repo
+            .bytes()
+            .all(|c| c.is_ascii_alphanumeric() || b"._-".contains(&c))
+}
+
+#[cfg(test)]
+mod github_repository_tests {
+    use super::valid_github_repository;
+
+    #[test]
+    fn github_release_accepts_null_title_and_body() {
+        let release: super::GitHubRelease = serde_json::from_str(
+            r#"{"tag_name":"v2.33.0","name":null,"body":null,"prerelease":false,"assets":[]}"#,
+        )
+        .unwrap();
+        assert!(release.name.is_none());
+        assert!(release.body.is_none());
+        assert_eq!(release.tag_name, "v2.33.0");
+    }
+
+    #[test]
+    fn github_repository_allows_safe_names() {
+        assert!(valid_github_repository("LingMoche", "MaaEnd"));
+        assert!(valid_github_repository("maa-org", "MaaEnd.Test_v2"));
+    }
+
+    #[test]
+    fn github_repository_rejects_path_and_query_injection() {
+        for (owner, repo) in [
+            ("", "MaaEnd"),
+            ("LingMoche/other", "MaaEnd"),
+            ("LingMoche", ".."),
+            ("LingMoche", "MaaEnd?per_page=999"),
+            ("LingMoche", "MaaEnd/../../other"),
+            ("LingMoche", "MaaEnd%2fother"),
+        ] {
+            assert!(!valid_github_repository(owner, repo));
+        }
+    }
+}
